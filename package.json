{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"resources/**/*.{ts,vue,css}\" \"*.{json,mjs}\"",
        "format:check": "prettier --check \"resources/**/*.{ts,vue,css}\" \"*.{json,mjs}\"",
        "typecheck": "vue-tsc --build"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "5.9.3",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@lucide/vue": "^1.67.0",
        "@tanstack/vue-table": "^9.3.1",
        "@vee-validate/yup": "^4.15.1",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "pinia": "^4.1.0",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "vue-sonner": "^2.0.9",
        "yup": "^1.7.1"
    }
}
