APP_NAME="IHOMS Ticketing System"
APP_DESCRIPTION="JBLMGH IT Helpdesk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Legacy timestamps are epoch seconds that follow Asia/Manila wall time.
APP_TIMEZONE=Asia/Manila
SHOW_DATABASE_URL=false

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Main legacy database. Read-only during development.
DB_CONNECTION=mysql
DB_HOST=change-me
DB_PORT=3306
DB_DATABASE=its
DB_USERNAME=change-me
DB_PASSWORD=

# PIS payroll source. Read-only. Used by the sync service only.
PAYROLL_DB_HOST=change-me
PAYROLL_DB_PORT=3306
PAYROLL_DB_DATABASE=jblmrhpayroll
PAYROLL_DB_USERNAME=change-me
PAYROLL_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Application settings. See PROMPT.md Appendix C.
ITS_BASE_URL=http://localhost:8080
ITS_TIMEZONE=Asia/Manila
ITS_APP_TITLE="IHOMS TICKETING SYSTEM"

# Session compatibility. See PROMPT Appendix C.
ITS_SESSION_NAME=expressservicedesk
ITS_SESSION_IDLE_SECONDS=28800
ITS_SESSION_ABSOLUTE_SECONDS=86400

# Login policy.
ITS_LOGIN_MAX_FAILURES=5
ITS_LOGIN_LOCKOUT_SECONDS=900
ITS_PASSWORD_MIN=12

# Business data. Do not change without a data decision.
ITS_CATEGORY_HARDWARE=23
ITS_CATEGORY_ANNOUNCEMENTS=24
ITS_CATEGORY_DEFAULT=1
ITS_LOCATION_IHOMS=15
ITS_GROUP_DEFAULT=1
ITS_APPROVAL_PENDING_CUTOFF=1784553600
ITS_APPROVAL_HIDE_OLD_CUTOFF=1784692800
ITS_COUNTER_EMPLOYEE_IDS=334,566,335,1555,336,2243,2415
ITS_COUNTER_UNITS_CUTOFF="2025-12-19 15:00:00"
ITS_SURVEY_URL="http://192.163.8.7/jblforms/form.php?use=V6U6202564133510372T1QA&ticketID={ticket_id}"

# Attachments.
ITS_ATTACHMENT_ROOT=storage/app/attachments
ITS_ATTACHMENT_MAX_BYTES=26214400
ITS_ATTACHMENT_TYPES="pdf,png,jpg,jpeg,gif,webp,txt,csv,doc,docx,xls,xlsx,ppt,pptx,zip"

# Lists, search, and UI.
ITS_CLOSED_LIST_LIMIT=4000
ITS_SEARCH_LIMIT=500
ITS_LIST_PAGE_SIZE=40
ITS_GRID_HEIGHT=700
ITS_SUBJECT_TRUNCATE=80
ITS_DASHBOARD_REFRESH_MS=5000
ITS_DEBOUNCE_SECONDS=1

# Notifications.
ITS_NOTIFICATION_MODE=in_app
ITS_EMAIL_BATCH_SIZE=25

# Email intake. Leave empty while email intake is disabled.
ITS_IMAP_HOST=
ITS_IMAP_PORT=993
ITS_IMAP_USER=
ITS_IMAP_PASSWORD=
ITS_IMAP_FOLDER=INBOX
ITS_IMAP_TLS=true

# Operations.
ITS_LOG_LEVEL=debug
ITS_TRUSTED_PROXIES=

APP_PORT=8080
VITE_PORT=5173
JWT_SECRET=
JWT_TTL=60

JWT_ALGO=HS256
